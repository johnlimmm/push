+  m_externalRx = std::move(rx);
+}
+
+bool TeleportationApp::NotifyExternalResourcesReady(uint64_t sid) {
+  if (!m_external || m_stopped || sid != m_sessionId || m_ready) return false;
+  m_ready = true;
+  if (m_role == "source") TryExternalBsm();
+  else if (m_sessionActive) TryApplyCorrection();
+  return true;
+}
+
+bool TeleportationApp::RequestExternalBsm(uint64_t sid) {
+  if (!m_external || !m_started || m_stopped || m_role != "source" ||
+      sid != m_sessionId || m_requested) return false;
+  m_requested = true;
+  TryExternalBsm();
+  return true;
+}
+
+void TeleportationApp::TryExternalBsm() {
+  if (!m_started || !m_sessionActive || m_stopped || !m_requested || !m_ready ||
+      m_bsmPending || m_bsmDone) return;
+  m_bsmPending = true;
+  m_externalBsm(m_sessionId, m_resources);
+}
+
+bool TeleportationApp::CompleteExternalBsm(uint64_t sid, uint8_t m1, uint8_t m2) {
+  if (!m_external || !m_started || m_stopped || m_role != "source" ||
+      sid != m_sessionId || !m_bsmPending || m_bsmDone || m1 > 1 || m2 > 1) return false;
+  m_bsmPending = false;
+  m_bsmDone = true;
+  m_traceSourceBellDone(sid, ns3::Simulator::Now());
+  SendCtrlBits(m1, m2);
+  return true;
+}
+
+bool TeleportationApp::CompleteExternalCorrection(uint64_t sid) {
+  if (!m_external || !m_started || m_stopped || m_role != "sink" ||
+      sid != m_sessionId || !m_correctionPending || m_done) return false;
+  m_correctionPending = false;
+  m_done = true;
+  m_traceSinkCorrection(sid, ns3::Simulator::Now());
+  return true;
+}
