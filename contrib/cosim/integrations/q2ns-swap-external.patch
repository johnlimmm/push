+
+void SwapApp::AddExternalSession(const SessionConfig& cfg, const ExternalResources& resources) {
+  // 첫 어댑터는 단일 repeater의 IPv4/UDP 거래만 허용한다. 미지원 경로를 조용히 실행하지 않는다.
+  if (m_started || !GetNode() || !cfg.sid || m_sessions.count(cfg.sid) || m_useIpv6 ||
+      (cfg.proto != "udp" && cfg.proto != "UDP") || cfg.genPrev || cfg.genNext || cfg.verifyFidelity ||
+      cfg.expectedMsgs != 1 || (cfg.role != Role::Repeater && cfg.role != Role::Next) ||
+      (cfg.role == Role::Next && !cfg.applyCorrections) ||
+      (cfg.role == Role::Repeater && (cfg.applyCorrections || cfg.nextEndAddr == ns3::Ipv4Address::GetAny())) ||
+      !cfg.ctrlPort || !resources.pairPrev || !resources.pairNext || !resources.outputPair ||
+      resources.pairPrev == resources.pairNext || resources.pairPrev == resources.outputPair ||
+      resources.pairNext == resources.outputPair ||
+      (cfg.role == Role::Repeater ? !m_externalBsm : !m_externalCorrection)) {
+    throw std::invalid_argument("Invalid external SwapApp session/configuration");
+  }
+  SessionState state;
+  state.cfg = cfg;
+  state.external = true;
+  state.externalResources = resources;
+  m_sessions.emplace(cfg.sid, std::move(state));
+  if (cfg.role == Role::Next) EnsureSink(cfg.ctrlPort, cfg.proto);
+}
+
+SwapApp::SessionState& SwapApp::ExternalSession(uint64_t sid, Role role) {
+  auto it = m_sessions.find(sid);
+  if (!m_started || it == m_sessions.end() || !it->second.external || it->second.cfg.role != role)
+    throw std::logic_error("External SwapApp session is unavailable or has the wrong role");
+  return it->second;
+}
+
+bool SwapApp::RequestExternalBsm(uint64_t sid) {
+  auto& s = ExternalSession(sid, Role::Repeater);
+  if (s.bsmPending || s.haveBSM) return false;
+  s.bsmPending = true;
+  m_traceRoundStart(sid, ns3::Simulator::Now());
+  m_externalBsm(sid, s.externalResources);
+  return true;
+}
+
+bool SwapApp::CompleteExternalBsm(uint64_t sid, uint8_t m1, uint8_t m2) {
+  auto& s = ExternalSession(sid, Role::Repeater);
+  if (m1 > 1 || m2 > 1) throw std::invalid_argument("Invalid external BSM bits");
+  if (s.haveBSM) {
+    if (s.accumM1 != m1 || s.accumM2 != m2) throw std::logic_error("Conflicting external BSM completion");
+    return false;
+  }
+  if (!s.bsmPending) throw std::logic_error("BSM completion without a pending request");
+  s.bsmPending = false;
+  s.haveBSM = true;
+  s.accumM1 = m1;
+  s.accumM2 = m2;
+  // 기존 Q2NS control packet 생성/UDP 송신 경로를 완료 시각에 실행한다.
+  AnnounceBsm(s, m1, m2);
+  return true;
+}
+
+bool SwapApp::CompleteExternalCorrection(uint64_t sid) {
+  auto& s = ExternalSession(sid, Role::Next);
+  if (s.done) return false;
+  if (!s.correctionPending) throw std::logic_error("Correction completion without a pending request");
+  s.correctionPending = false;
+  s.done = true;
+  m_traceCorrectionApplied(sid, ns3::Simulator::Now());
+  return true;
+}
