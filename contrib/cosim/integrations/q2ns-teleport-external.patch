+void TeleportationApp::ConfigureExternal(const ExternalResources& resources,
+    ExternalBsmRequest bsm, ExternalCorrectionRequest correction) {
+  if (m_started || m_stopped || m_external || m_teleportState || !m_sessionId || m_ctrlProto != "udp" ||
+      !resources.input || !resources.epr || !resources.output ||
+      resources.input == resources.epr || resources.input == resources.output ||
+      resources.epr == resources.output ||
+      (m_role == "source" ? !bsm : (m_role != "sink" || !correction)))
+    throw std::invalid_argument("invalid external teleport configuration");
+  m_external = true;
+  m_resources = resources;
+  m_externalBsm = std::move(bsm);
+  m_externalCorrection = std::move(correction);
+}
+
+void TeleportationApp::SetExternalPacketObservers(ExternalPacketObserver tx, ExternalPacketObserver rx) {
+  if (m_started) throw std::logic_error("set observers before start");
