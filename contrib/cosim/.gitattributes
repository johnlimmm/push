# Preserve generated evidence bytes so published SHA-256 hashes stay valid.
paper/*.csv -text whitespace=cr-at-eol
paper/provisioned-v4/*.csv -text whitespace=cr-at-eol
paper/chained-v5/*.csv -text whitespace=cr-at-eol
results/** -text whitespace=cr-at-eol
# Current and archived evaluation packages also carry byte-level provenance.
paper/evaluation*/data/*.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
